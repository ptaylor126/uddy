# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Resend
RESEND_API_KEY=re_xxx
ADMIN_EMAIL=hello@uddyskincare.com

# Site
NEXT_PUBLIC_BASE_URL=https://uddyskincare.com

# Pre-launch mode. When "true", middleware redirects all routes to the landing page.
# Set to "false" when you're ready for the full site to go live.
NEXT_PUBLIC_PRELAUNCH_MODE=true

# Supabase credentials (Project Settings > API in Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Email settings (for pre-launch signup confirmation)
EMAIL_FROM="Uddy <hello@uddyskin.com>"
EMAIL_REPLY_TO=hello@uddyskin.com
